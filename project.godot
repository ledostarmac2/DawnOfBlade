; Engine configuration file.
; Open this project with Godot 4 .NET/C# and let the editor regenerate any solution files it needs.

config_version=5

[application]

config/name="Dawn of Blade"
run/main_scene="res://scenes/UI/Login.tscn"
config/features=PackedStringArray("4.2", "C#", "Forward Plus")
config/icon="res://assets/branding/dawn_of_blade_icon_transparent.png"
boot_splash/image="res://assets/branding/dawn_of_blade_logo.png"
boot_splash/fullsize=true
boot_splash/use_filter=true
boot_splash/bg_color=Color(0.0156863, 0.0156863, 0.0156863, 1)

[display]

window/size/viewport_width=1152
window/size/viewport_height=720
window/size/window_width_override=1152
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="DawnOfBlade"
